# Optional: OpenAI for tailored cover letters and resume notes.
# If unset, the agent tries Ollama, then a template fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional local model (you already have Ollama on this machine).
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Required only for the API / Docker Compose stack.
JOB_AGENT_API_KEY=
POSTGRES_PASSWORD=
